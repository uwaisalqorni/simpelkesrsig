# ==============================================================================
# SIMPELKES IPSRS - Production Environment Configuration Template
# ==============================================================================

# Application Environment: 'production', 'development', atau 'testing'
CI_ENV=production

# Database Configuration (MariaDB / MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=simpelkes
DB_PORT=3306

# JSON Web Token (JWT) Security Secret Key
# Pastikan mengganti nilai ini dengan string acak dan aman di server production!
JWT_SECRET=SIMPELKES_RS_SECRET_TOKEN_KEY_2026_!#@#99
JWT_EXPIRE_SECONDS=604800

# CORS Security (Allowed Origins)
# Pisahkan dengan koma jika ada beberapa origin, misal:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost/simpelkesrsig,https://simpelkes.rsig.id
# Gunakan '*' hanya untuk development lokal
CORS_ALLOWED_ORIGINS=*

# Hospital Default Branding
DEFAULT_HOSPITAL_NAME="RS Islam Gondanglegi"
